timeseries r = sum(custom.nexus.log.adapter.responses), by: { nexus.cluster, nexus.outcome }
| fieldsAdd n = arraySum(r)
| summarize total = sum(n), errors = sum(if(nexus.outcome == "error", n, else: 0)),
    business_412 = sum(if(nexus.outcome == "business_412", n, else: 0)), by: { nexus.cluster }
| fieldsAdd pct_error = round(100.0 * errors / total, decimals: 2)
| sort pct_error desc
