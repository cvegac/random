timeseries r = sum(custom.nexus.log.adapter.responses), by: { cluster, outcome }
| fieldsAdd n = arraySum(r)
| summarize total = sum(n), errors = sum(if(outcome == "error", n, else: 0)),
    business_412 = sum(if(outcome == "business_412", n, else: 0)), by: { cluster }
| fieldsAdd pct_error = round(100.0 * errors / total, decimals: 2)
| sort pct_error desc
