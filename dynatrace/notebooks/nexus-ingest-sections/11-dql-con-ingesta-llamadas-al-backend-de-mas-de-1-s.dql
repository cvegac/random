timeseries c = sum(custom.nexus.log.adapter.backend_calls), by: { component, latency_bucket }
| fieldsAdd n = arraySum(c)
| summarize total = sum(n), slow = sum(if(in(latency_bucket, array("1-5s", "5s+")), n, else: 0)), by: { component }
| fieldsAdd pct_slow = round(100.0 * slow / total, decimals: 2)
| sort pct_slow desc
